/**
 * Logout
 *
 * logs out user, clears header information and closes all modal dialogs
 *
 * @return	void
 */
function logOut() {
    window.location.hash = 'logout';
	
    $('#xInfo').html('<tr><td>&nbsp;</td></tr>');
	autoAdjustSection();
	
    $('nav').remove();
	$('#tellerMenu').fadeOut();
    if ($(DIALOG).length > 0) {
        $(DIALOG).dialog('close')
    }
}

