/**
 * Image Preloader
 *
 * preloads image array
 *
 * @param	array
 * @return	void
 */
function preload(a) {
    $(a).each(function () {
        $('<img/>')[0].src = this
    })
}

// --------------------------------------------------------------------

/**
 * Input Filter (letters only)
 *
 * allowed inputs (A-Z, a-z, delete, backspace, tab, enter, space
 *
 * @param	int		charcode
 * @return	boolean
 */
function lettersOnly(n) {
    switch (true) {
		case (n === 0): //delete
		case (n == 8): //backspace
		case (n == 9): //tab
		case (n == 13): //enter
		case (n == 32): //space
		case ((n >= 65) && (n <= 90)): //A-Z
		case ((n >= 97) && (n <= 122)): //a-z
			return true;
			break;
		default:
			return false;
			break;	
	}
}

// --------------------------------------------------------------------

/**
 * Input Filter (numbers only)
 *
 * allowed inputs (0-9, delete, backspace, tab, enter, space
 *
 * @param	int		charcode
 * @return	boolean
 */
function numbersOnly(n) {
    switch (true) {
		case (n === 0): //delete
		case (n == 8): //backspace
		case (n == 9): //tab
		case (n == 13): //enter
		//case (n == 32): //space
		case ((n >= 48) && (n <= 57)): //0-9
			return true;
			break;
		default:
			return false;
			break;	
	}
}

// --------------------------------------------------------------------

/**
 * Input Filter (integers only)
 *
 * allowed inputs (0-9, period, delete, backspace, tab, enter
 *
 * @param	int		charcode
 * @return	boolean
 */
function integersOnly(n) {
    switch (true) {
		case (n === 0): //delete //tab
		case (n == 8): //backspace
		case (n == 9): //tab
		case (n == 13): //enter
		//case (n == 32): //space
		case (n == 46): //.
		//case (n == 44): //,
		case ((n >= 48) && (n <= 57)): //0-9
			return true;
			break;
		default:
			return false;
			break;	
	}
}

// --------------------------------------------------------------------

/**
 * Input Filter (alphanumeric only)
 *
 * allowed inputs (A-Z, a-z, 0-9, delete, backspace, tab, enter, space
 *
 * @param	int		charcode
 * @return	boolean
 */
function alphaNumericOnly(n) {
    switch (true) {
		case (n === 0): //delete
		case (n === 8): //backspace
		case (n === 9): //tab
		case (n === 13): //enter
		case (n === 32): //space
		case ((n >= 48) && (n <= 57)): //0-9
		case ((n >= 65) && (n <= 90)): //A-Z
		case ((n >= 97) && (n <= 122)): //a-z
			return true;
			break;
		default:
			return false;
			break
    }
}

// --------------------------------------------------------------------

/**
 * Input Filter (alphanumeric only)
 *
 * allowed inputs (A-Z, a-z, 0-9, delete, backspace, tab, enter, space
 *
 * @param	int		charcode
 * @return	boolean
 */
function alphaNumericOnlyCustom(n) {
    switch (true) {
		case (n === 0): //delete
		case (n === 8): //backspace
		case (n === 9): //tab
		case (n === 13): //enter
		case (n === 32): //space
		case ((n >= 48) && (n <= 57)): //0-9
		case ((n >= 65) && (n <= 90)): //A-Z
		case ((n >= 97) && (n <= 122)): //a-z
		case (n === 241): //ñ
		case (n === 209): //Ñ
		case (n === 39): // '
		case ((n >= 44) && (n <= 46)): // , - .
			return true;
			break;
		default:
			return false;
			break
    }
}

// --------------------------------------------------------------------

/**
 * Input Filter (alphanumeric only, no spaces)
 *
 * allowed inputs (A-Z, a-z, 0-9, delete, backspace, tab, enter
 *
 * @param	int		charcode
 * @return	boolean
 */
function alphaNumericOnlyNoSp(n) {
    switch (true) {
		case (n === 0): //delete
		case (n === 8): //backspace
		case (n === 9): //tab
		case (n === 13): //enter
		case ((n >= 48) && (n <= 57)): //0-9
		case ((n >= 65) && (n <= 90)): //A-Z
		case ((n >= 97) && (n <= 122)): //a-z
			return true;
			break;
		default:
			return false;
			break
    }
}

// --------------------------------------------------------------------

/**
 * Input Filter (hex only, no spaces)
 *
 * allowed inputs (A-F, a-f, 0-9, delete, backspace, tab, enter
 *
 * @param	int		charcode
 * @return	boolean
 */
function hexOnly(n) {
    switch (true) {
		case (n === 0): //delete
		case (n === 8): //backspace
		case (n === 9): //tab
		case (n === 13): //enter
		case ((n >= 48) && (n <= 57)): //0-9
		case ((n >= 65) && (n <= 70)): //A-F
		case ((n >= 97) && (n <= 102)): //a-f
			return true;
			break;
		default:
			return false;
			break
    }
}

// --------------------------------------------------------------------

/**
 * Session Expiry Handler
 *
 */

var sesstimer;

function initSession(sessionLength) {
	clearTimeout(sesstimer);
	
	var len = parseInt(sessionLength) * 60 * 1000;
	if (len > 0) {
		console.log('Session started... will expire in ' + sessionLength + ' minutes.');
		
		function sessionExp() {
			$.ajax({
				url: 'logout',
				success: function () {
					messageBox('Your session has expired. Please relogin');
					$(MSGBOX).one('dialogbeforeclose', logOut);
					setTimeout(logOut, 10000);
				}
			});
		}
		
		sesstimer = setTimeout(sessionExp, len);
	}
}
