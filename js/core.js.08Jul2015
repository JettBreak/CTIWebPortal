/**
 * Right Click Disabler
 *
 * @return	void
 */
function disableContextMenu() {
    document.oncontextmenu = function () {
        return false
    }
}

// --------------------------------------------------------------------

/**
 * URL Encoder
 *
 * @return	void
 */
function urlEncode(a) {
    a = (a + '').toString();
    return encodeURIComponent(a).replace(/!/g, '%21').replace(/'/g, '%27').replace(/\(/g, '%28').replace(/\)/g, '%29').replace(/\*/g, '%2A').replace(/%20/g, '+')
}

// --------------------------------------------------------------------

/**
 * Table Row Color Changer
 *
 * returns row color according to message type or void code
 * vCodes = check constants.js
 *
 * @param	int
 * @param	string
 * @return	string	row color
 */
function getRowColor(msgType, vCode) {
	var color = null;
	//greater than -1 means true.. check http://api.jquery.com/jQuery.inArray/
	if ($.inArray(msgType, [23, 53, 63, 73, 83, 103]) > -1) {
		color = 'redRow';
	}
	if ($.inArray(msgType, [20, 50, 60, 70, 80, 100]) > -1) {
		color = 'blueRow';
	}
	if ($.inArray(msgType, [71, 72]) > -1) {
		color = 'orangeRow';
	}
	if (vCode) {
		if ((vCodes !== []) && $.inArray(vCode, vCodes) > -1) {
			color = 'purpleRow';
		}
	}
	
	return color;
}

// --------------------------------------------------------------------

/**
 * Table Row Color Changer (ATM Supplies)
 *
 * returns row color according to status code
 *
 * @param	int
 * @return	string	row color
 */
function getRowColorSupplies(statCode) {
	var color = null;

	switch (statCode) {
		case 2:
			color = 'yellowRow';
			break;
		case 3:
			color = 'maroonRow';
			break;
		case 4:
			color = 'redRow';
			break
	}
	return color;
}

