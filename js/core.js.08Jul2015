/**
 * "document.ready"
 *
 */
$(function () {

    $(WRAPPER + ' input').live('focusin', function () {
        if ($(MSGBOX).length > 0) {
            $(MSGBOX).dialog('close');
        }
        if ($(DIALOG).length > 0) {
            $(DIALOG).dialog('close');
            $('form').validationEngine('hideAll')
        }
    });
	
	// --------------------------------------------------------------------

	/**
	 * Input Box White Spaces Remover
	 *
	 * Trims input box e.g "Text      " => "Text"
	 *
	 */
    $('input').live('focusout', function () {
        this.value = $.trim(this.value);
    });
	
	// --------------------------------------------------------------------

	/**
	 * Logout Button Live Event
	 *
	 */
    $('#logout').live('click', function () {
        messageBox('Are you sure you want to logout?', 'Logout', 'confirm', function () {
            $(MSGBOX).dialog('close');
            if ($(WRAPPER).is(':hidden') === true) {
                $(WRAPPER).show()
            }
            logOut();
        });
        return false;
    });
	
	// --------------------------------------------------------------------

	/**
	 * Back Button Fix
	 *
	 */
    $(window).bind('hashchange', function () {
        if ((window.location.hash === '#login') || (window.location.hash === '#logout') || (window.location.hash === '#setpw') || (window.location.hash === '#forgotpw')) {
            if ($('#instName').text() !== '') {
                window.location.hash = '';
            }
        }
        return false;
    });
	
	// --------------------------------------------------------------------

	/**
	 * Dynamic Form Close Live Event 
	 *
	 * hides current opened form, aborts all AJAX requests, hides floating menu, clears intervals
	 *
	 */
    $('.closebtn').live('click', function () {
        $(DIALOG + ',' + MSGBOX).dialog('close');
        if (window.location.hash !== '#welcome') {
            var panel = $('.panel');
            var menu = $('#floatMenu');
            menu.animate({
                left: 0,
            }, {
                duration: 500,
                queue: false
            });
            panel.attr('title', 'Hide Panel');
            panel.toggle(function () {
                menu.animate({
                    left: -menu.width()
                }, {
                    duration: 500,
                    queue: false
                });
                panel.attr('title', 'Show Panel');
            }, function () {
                menu.animate({
                    left: 0
                }, {
                    duration: 500,
                    queue: false
                });
                panel.attr('title', 'Hide Panel');
            })
        }
        abortAJAXRequests();
        if ($('form').length) {
            $('form').validationEngine('hideAll');
        }
        $(WRAPPER).fadeOut();
        clearInterval(intervals);
        return false;
    });
	
	// --------------------------------------------------------------------

	/**
	 * Window Resize Event
	 *
	 */
	 
    $(window).resize(function () {
        $('form').validationEngine('hideAll');
		autoAdjustSection();
    });

	// --------------------------------------------------------------------

	/**
	 * Buttons Live Events
	 *
	 * changes form action according to button value
	 *
	 */
    $(WRAPPER).find('button').live({
		'click': function () {
			//form action = button value
			$('form').attr('action', this.value);
		},
		'focusout': function () {
			//close all dialog boxes
			/*if ($(MSGBOX).length > 0) {
				$(MSGBOX).dialog('close');
			}*/
		}
	});
	
	// --------------------------------------------------------------------

	/**
	 * Input Filters Live Events
	 *
	 */
    $('input.numbersOnly').live('keyup keypress', function (e) {
        return numbersOnly(e.which)
    });
	$('input.integersOnly, input.currencyOnly').live('keyup keypress', function (e) {
        return integersOnly(e.which)
    });
	$('input.integersOnly').live('focusout', function(e) {
		if (this.value !== '') {
			return this.value = this.value.replace(/^0+/, '');
		}
	});
    $('input.lettersOnly').live('keyup keypress', function(e) {
        return lettersOnly(e.which)
    });
    $('input.alphaNum').live('keyup keypress', function(e) {
        return alphaNumericOnly(e.which)
    });

    $('input.alphaNumCustom').live('keyup keypress', function(e) {
        return alphaNumericOnlyCustom(e.which)
    });
	$('input.alphaNumNoSp').live('keyup keypress', function(e) {
        return alphaNumericOnlyNoSp(e.which)
    });
	$('input.hexOnly').live('keyup keypress', function(e) {
        return hexOnly(e.which)
    });
	//currency
	$('input:not([readonly]).currencyOnly').live('focusout', function(e) {
		if (this.value === '') {
			this.value = '0.00';
		} else {
			this.value = formatCurrency(this.value);
		}
	}).live('focusin', function(e) {
		if (this.value === '0.00') {
			this.value = '';
		} else {
			this.value = this.value.replace(/,/gi, '');
		}
	});
	// --------------------------------------------------------------------

	/**
	 * Paste Disabler
	 *
	 * affects all inputs with type="text" property
	 *
	 */
	$('input:text').live('paste', function() {
		return false;
	});
	//$('input[readonly]').attr('onFocus', '');
	
	// --------------------------------------------------------------------

	/**
	 * Input Min Max Control
	 *
	 * affects all inputs with "step" attribute
	 * sets input min max on focusout according to attr value
	 *
	 */
	$('input[step]').live('focusout', function () {
		var maxInput = $(this).attr('max');
		var minInput = $(this).attr('min');
		var val = parseInt(this.value);
		
		if (val < minInput || this.value === '') {
			return this.value = minInput;
		}
		
		if (val > maxInput) {
			return this.value = maxInput;
		}
	});
	
	// --------------------------------------------------------------------

	/**
	 * AJAX Setup
	 *
	 * overrides jquery default AJAX setup
	 *
	 */
    $.ajaxSetup({
        timeout: TIMEOUT
    });
});

// --------------------------------------------------------------------

/**
 * On AJAX Error Trigger
 *
 */
$(document).ajaxError(function (event, jqXHR, ajaxSettings, thrownError) {
	
	//parse error handler
	if (event.type === 'ajaxError') {
		//location.reload(true);
	}
	
	if (jqXHR.statusText === 'timeout') {
		messageBox('Connection timed out. Please try again later.', 'Error');
		$(MSGBOX).one('dialogbeforeclose', function () {
			window.location.hash = 'welcome';
		});
	} else {
		try {
			var json = $.parseJSON(jqXHR.responseText);
			if ((json.success === false)) {
				messageBox(json.message, json.heading)
			}
		} catch (e) {}
	}
    	/*data.error(function (a, b, c) {
        if (b == 'timeout') {
            messageBox('Connection timed out. Please try again later.', 'Error');
            if ($(WRAPPER + ' h1').text() === 'Loading') {
                window.location.hash = 'welcome'
            }
        }
    })*/
});

// --------------------------------------------------------------------

/**
 * On AJAX Start Trigger
 *
 * aborts all AJAX requests
 *
 */
$(document).ajaxStart(function() {
	abortAJAXRequests();
    //$('section').css('cursor', 'wait');
});

// --------------------------------------------------------------------

/**
 * On AJAX Success Trigger
 *
 * if invalid session, force logout
 *
 */
$(document).ajaxSuccess(function(event, XMLHttpRequest, ajaxOptions) {
    try {
        var data = $.parseJSON(XMLHttpRequest.responseText);
        if ((data.success === false) && (data.errorno == 8)) {
            messageBox(data.message);
			$(MSGBOX).one('dialogbeforeclose', logOut);
        }
    } catch (e) {
	}
    requests = [];
});
