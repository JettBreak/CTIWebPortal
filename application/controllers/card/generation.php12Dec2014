			'<IPADDR>'. $core->getIPAddress() .'</>'.
			'<BRSEQN0>'. $brseqno .'</>'.
			'<CIFNO>'. $cifseqno .'</>'.
			'<ORDERNO>'. $orderNo .'</>'.
			'<BEGINCARD>'. $fcard .'</>'.
			'<ENDCARD>'. $lcard .'</>';
		
		$query = "CALL sp_insertlogclixx(".
			"41,".
			"990314,".
			"?,".
			"0,0,'CARD','',".
			"?,'','','','','','','',?,'','WEB','WEB',?,?)";
		
		$params = array($brseqno, $userAudit, $userAudit, $workstation, $xml2);
		
		$card->db->query($query, $params);
			
		if ($card->db->trans_status() === FALSE) {
			$card->db->trans_rollback();
			$success = FALSE;
		} else {
			//$card->db->trans_rollback();
			$card->db->trans_commit();
		}
		
		return $success;
	}	
	
	function isProductExist($prType, $prKey)
	{
		if ($this->core->isCoreEncrypt()) {
			$query = "CALL CoreSecurity.VerifyHVV( 'prmaster', 'prkey', null,  SUBSTRING(".$prKey.", -6) , ".$prKey.", @tokenid, @errno)";
			$result = $this->card_model->db->query($query);

			$query = "SELECT @tokenid AS tokenid, @errno AS errno"; //
			$result = $this->card_model->db->query($query);

			$numRows = $result->row_array();
			$numRows = $numRows['errno'] > 0 ? 0 : 1; // if 0 FALSE, if 1 TRUE

		} else {
			$query = "SELECT prkey FROM prmaster WHERE prtype = ? AND prkey = ? LIMIT 1";
			$result = $this->card_model->db->query($query, func_get_args());
			$numRows = $result->num_rows();
		}
		
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
					
		return $numRows > 0 ? TRUE : FALSE;
	}
	
	function generate()
	{
		$this->load->model('coreapp/card_model');
		$this->load->library('core');

		$orders = $this->input->post('order', TRUE);
		$sessionID = $this->core->getSessionID();
		$generated = 0;
		$orderNos = array();
		
		// pad to force the browser to starting parsing/executing
		echo str_pad('<html><body>', 4096);
		
		$startTime = microtime(true);
		$startMemory = memory_get_usage();
		
		foreach ($orders as $order) {
			
			$order = explode(',', $order);
			$orderNo = $order[0];
			$brseqno = $order[1];
			
			$result = $this->_generateCards($orderNo, $brseqno);//, $userAudit, $sessionID);
			
			//errno, count number of success
			$generated++;
			$orderNos[] = $orderNo;
			
			//$result->free_result();
			//$result->next_result();
		}
		
		$endTime = microtime(true);
		$endMemory = memory_get_usage();
		
		echo '</body></html>';
			
		$json = json_encode(array(
			'success' => TRUE,
			'generated' => $generated,
			'orderNos' => $orderNos,
			//'message' => $result
			'message' => 'Card generation completed<br/>' .
				'Process took '. round($endTime - $startTime, 4) . ' seconds'
				//'End Mem: '. $endMemory
		));
		
		echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
		flush();
	}

	function cardnogeneration()
	{
		$json = json_encode(array(
			'success' => FALSE,
			'generated' => '',
			'orderNos' => '',
			//'message' => $result
			'message' => 'Unable to established connection.'
				//'End Mem: '. $endMemory
		));

		echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
		flush();
	}
}