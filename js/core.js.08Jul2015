/**
 * Auto Adjust Section Tag
 *
 */
 
function autoAdjustSection() {
	/*$('section').css({
		top: $('header').height() + 20 + 'px'
	});*/
	$('section').stop().animate({
		top: $('header').height() + 20
	}, 300);
}

