		$xml->editTag('ENDCARD', $lcard);
		
		$xml1 = $xml->getXML();
		
		$query = "UPDATE crdorder SET ".
			"dtgenerated = NOW(),".
			"status = 4,".
			"useraudit = ?,".
			"xml1 = ?".
			" WHERE orderno = ?".
			" AND status = 7 AND ".
			"gencount = ? LIMIT 1";
		
