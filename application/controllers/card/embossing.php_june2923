          array_push($paramsGetAllByOffset, $limit); // 
          array_push($paramsGetAllByOffset, $offset); // offset

          $query  = $query;
          $parameterbyoffset = json_encode($paramsGetAllByOffset);

          $result = $card->db->query($query, $paramsGetAllByOffset);
          $lastResult = $result->result_array();

          $result->free_result();
          $result->next_result();
          
          $this->queue = array();

          foreach ($lastResult as $row) {
            $xml->setXML($row['xml1']);
            $mpOut = '';
            $mpOut2= '';
            $xmlstring = '';
            
            $xBIN = $xml->getValue('BIN');
            $prseqno = intval($row['prseqno']);
            $acctType = $row['accttype'];
            $brcode = $row['brcode'];
            $prkey = $this->coreencrypt ? $row['prkey1'] : $row['prkey'];
            $cardNo = substr($prkey, (strlen($xBIN) + strlen($brcode)));
            
            if (in_array('', array($prseqno, $acctType, $brcode, $prkey))) {
              continue;
            }
            
            $time = date('Y-M-d H:i:s');
            $name = $xml->getValue('MBOS');
            
            if (strlen(trim($name)) === 0) {
              $name = '#' . substr(' ', 17);
            }

            $embStatus = $embStatList['x'. $acctType];
        
            $mpprkey = $prkey;

            $fp = NULL;
            $rport = 3003;
            $rhost = 'localhost';

            try {
              if (@fsockopen($rhost, $rport, $errno, $errstr, 10)) {
                $fp = fsockopen($rhost, $rport, $errno, $errstr, 10);
              } else {
                $message = "Warning: Unable to connect to port [".$rport."]";
                $success = FALSE;
              }
            } catch (Exception $e) {
              
              $message = 'Catch Error while connecting to port['.$rport.']';//$errno !== NULL ? $errno : $e;
              $success = FALSE;
            }

            if (!$fp) {
              $success = FALSE;
              $message = "Warning: Unable to connect to port [".$rport."]";
            } else {
            
              $dtexpiry = date('Ymd', strtotime($row['dtexpire']));
              $out = '<MSGTYPE>50</><TRXCODE>'.TRXCODE_ICVV.'</><PRTYPE1>CARD</><PRKEY1>'.$mpprkey.'</><TPNODE>POS</><EXPIRY>'.$dtexpiry.'</>'."\x00";
              
              fwrite($fp, $out);
            
              $msg = '';

              $starttime = time();

              while (TRUE) {
                $x = fgets($fp, 2);
                $time = time() - $starttime;
                if ($x == "\x00") {
                  $success = TRUE;
                  break;
                } elseif ($time > 60) {
                  $success = FALSE;
                  $message = "Connection Timeout (timelapse: ".$time." Starttime: ".$starttime." Endtime: ".time().")";
                  break;
                } else {
                  $success = TRUE;
                }

                $msg .= $x;
              }

              $xmlstring = $msg;
              $xmldata->setXML($msg);
              
              fclose($fp);
            }

            /*echo str_pad('<script>console.log("'.$xmlstring.'");</script>'."\n", 1024);
            flush();*/

            /*echo str_pad('<script>console.log("'.$message.'");</script>'."\n", 1024);
            flush();*/

            $queueSuccess = FALSE;
            $failedstatusupdate = 0;
            if ($success) {
              $msgtype = intval($xmldata->getValue('MSGTYPE'));
              if ( in_array($msgtype, array(53, 73)) ) {
                $success = FALSE;
                $message = $xmldata->getValue('SYSVDESC').$msgtype;
                
              } else {

                if (!$success) { 
                  $message = 'Unable to save data.';
                } else {
                  $message .= $xmlstring;

                  $queueSuccess = $this->_buildQuery($embStatus, $batchNo, $prseqno);
                  
                  $checker = $queueSuccess ? "GOOD" : "BAD";

                  echo str_pad('<script>console.log("'.$xmlstring.'");</script>'."\n", 1024);
                  flush();
                  if ($queueSuccess) {
                    $progress++;
                    if ($totalProg !== round($progress/$total * 100)) {
                      $totalProg = round($progress/$total * 100);
                              
                      echo str_pad('<script>parent.updateProgress('. $totalProg .');</script>'."\n", 1024);
                      flush();
                    }
                    $xcntr++;

                  } else {
                    $failedstatusupdate++;
                  }
                }
              }
            }

            if ($queueSuccess) {
            
              $hsmcvv   = $xmldata->getValue('HSMCVV');//'000';
              $extcode  = '620';
              $cvccode1 = $xmldata->getValue('HSMCVV');//'001';

              // Emboss Serial No., length (6)
              $mpEmbSerial = str_pad($xcntr, 5, '0', STR_PAD_LEFT);
              // 1st Separator, length (1)
              $mpSeparator1 = '$'; 
              // Card Number, length (16)
              $mpCardNoP1 = substr($mpprkey, 0, 4);
              $mpCardNoP2 = substr($mpprkey, 4, 4);
              $mpCardNoP3 = substr($mpprkey, 8, 4);
              $mpCardNoP4 = substr($mpprkey, 12, 4);
              // Card Number separator
              $mpCardNoSeparator = ' '; // single space
              // 1st Spaces, length (7)
              $mpSpaces1 = str_pad('', 7, ' ', STR_PAD_LEFT);
              // 2nd Separator, length (1)
              $mpSeparator2 = '*';
              // Member Date length (5)
              $mpMemberDate = date('m/y', strtotime($row['dtenroll']));
              // Enroll Date length (5)
              $mpEnrollDate = date('m/y', strtotime($row['dtenroll']));
              // Expiry Date length (5)
              $mpExpiryDate = date('m/y', strtotime($row['dtexpire']));
              // 2nd Spaces, length (5)
              $mpSpaces2 = str_pad('', 5, ' ', STR_PAD_LEFT);
              // 3rd Separator, length (2)
              $mpSeparator3 = '!(';
              // 3rd Spaces, length (20)
              $mpSpaces3 = str_pad('', 20, ' ', STR_PAD_LEFT);
              // 4th Separator, length (1)
              $mpSeparator4 = '#';
              // Name Embossed on card, length (26)
              $mpCardEmboss = str_pad(substr('', 0, 26), 26, ' ', STR_PAD_RIGHT);
              // Customer Name, length (35)
              $mpCustName = str_pad('', 16, ' ', STR_PAD_RIGHT);
              // Email Address, length (16)
              $mpEmailAddr = str_pad('', 16, ' ', STR_PAD_RIGHT);
              // Address1, length (50)
              $mpAddress1 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address2, length (50)
              $mpAddress2 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address3, length (50)
              $mpAddress3 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address4, length (50)
              $mpAddress4 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address5, length (50)
              $mpAddress5 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // City, length (50)
              $mpCity = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // Country, length (50)
              $mpCountry = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // Branch Code, length (10)
              $mpBranchCode = str_pad($row['brcode'], 10, ' ', STR_PAD_RIGHT);
              // 1st End Sentinel, length (1)
              $mpEndSentinel1 = ':';
              // 1st Start Sentinel, length (1)
              $mpStartSentinel1 = '%';

              
              // Track 1
                // Format Code
                $mpTrack1Formatcode = 'B';
                // Card Number
                $mpTrack1CardNumber = substr($mpprkey, 0, 16);
                // T1 1st Separator
                $mpTrack1Separator1 = '^';
                // Name in Track 
                $mpTrack1NameNTrack = str_pad('', 26, ' ', STR_PAD_RIGHT);
                // T1 2nd Separator
                $mpTrack1Separator2 = '^';
                // T1 Expiry date(format)                                                                                                               
                $mpTrack1ExpiryDate = date('ym', strtotime($row['dtexpire']));
                // T1 Service Code
                $mpTrack1ServiceCde = '201';
                // T1 CVC 1
                $mpcvccode1 = str_pad($cvccode1, 18, '0', STR_PAD_LEFT);
                // T1 trailing zeroes
                $mpZeroes1  = str_pad('', 6, '0', STR_PAD_LEFT);
                // T1 PIN Verification
                $mpTrack1PINVerify  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T1 1st Zeroes
                $mpTrack1Zeroes1  = str_pad('', 2, '0', STR_PAD_LEFT);
                // T1 CVV
                $mpTrack1CVV    = str_pad($hsmcvv, 3, '0', STR_PAD_LEFT);
                // T1 2nd Zeroes
                $mpTrack1Zeroes2  = str_pad('', 6, '0', STR_PAD_LEFT);
              
              // 2nd End Sentinel
              $mpEndSentinel2 = '?';
              // 2nd Start Sentinel
              $mpStartSentinel2 = ';';

              
              // Track 2
                // T2 Card Number
                $mpTrack2CardNumber = substr($mpprkey, 0, 16);
                // T2 1st Separator
                $mpTrack2Separator1 = '=';
                // T2 Expiry Date
                $mpTrack2ExpiryDate = date('ym', strtotime($row['dtexpire']));
                // T1 CVC 1
                $mpcvccode2 = str_pad($cvccode1, 3, '0', STR_PAD_LEFT);
                // T1 trailing zeroes
                $mpZeroes2  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T2 Service Code
                $mpTrack2ServiceCde = '620';
                // T2 PIN Verification
                $mpTrack2PINVerify  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T2 CVV
                $mpTrack2CVV    = str_pad($hsmcvv, 3, '0', STR_PAD_LEFT);

              // 3rd End Sentinel
              $mpEndSentinel3 = '?';
              // iCVV
              $mpICVV = str_pad($hsmcvv, 3, '0', STR_PAD_LEFT);
              // PAN Sequence Number
              $mpPANSeqNo = substr($mpprkey, 14, 2);
              // Branch Name/ID
              $mpBranch = str_pad('', 17, ' ', STR_PAD_LEFT);
              // @ separator
              $mpAtSeparator = '@';


              $mpOut .= $mpEmbSerial.$mpSeparator1.$mpCardNoP1.$mpCardNoSeparator.$mpCardNoP2.$mpCardNoSeparator.$mpCardNoP3.$mpCardNoSeparator.$mpCardNoP4.$mpSeparator1.$mpCardEmboss.
                $mpSeparator1.$mpMemberDate.$mpSeparator1.$mpEnrollDate.$mpSeparator1.$mpExpiryDate.$mpSeparator1.$mpStartSentinel1.$mpTrack1Formatcode.$mpTrack1CardNumber.$mpTrack1Separator1.
                $mpTrack1NameNTrack.$mpTrack1Separator1.$mpTrack1ExpiryDate.$extcode.$mpcvccode1.$mpZeroes1.$mpEndSentinel2.$mpStartSentinel2.$mpTrack2CardNumber.$mpTrack2Separator1.
                $mpTrack2ExpiryDate.$extcode.$mpZeroes2.$mpcvccode2.$mpZeroes2.$mpEndSentinel3.$mpSeparator1.$mpICVV.$mpSeparator1.$mpPANSeqNo.$mpSeparator1.$mpBranch.$mpAtSeparator.$mpCustName.$mpEmailAddr.
                $mpAddress1.$mpAddress2.$mpAddress3.$mpAddress4.$mpAddress5.$mpAtSeparator."\r\n";

              $content .= $mpOut;

              $content2 .= $mpOut2;
            }
          }

          $content = str_pad($xcntr, 4, '0', STR_PAD_LEFT)."\r\n".$content;
          
          $queue = $this->_getQuery();
    
          $card->db->trans_begin();
          
          if (count($queue) > 0) {
            foreach ($queue as $x) {
              $sql = $x[0];
              $paramx = $x[1];
              $card->db->query($sql, $paramx);
            }
          }
          
          if ($card->db->trans_status() === FALSE) {
            $card->db->trans_rollback();
          } else {
            $card->db->trans_commit();
          }
        }

        $result->free_result();
        $result->next_result();

        $acctdesc = $card->card_model->getCardTypeDesc(intval($acctType)); 
        $acctrow = $acctdesc->row_array();
        $acctname = str_replace(" ", "", trim($acctrow['acctname']));

        $result->free_result();
        $result->next_result();

        if ($xcntr == 0 && $core->hasBatchCardUpload()) {
          if ($failedstatusupdate > 0) {
            $message = 'An error has occured while updating card status';
          }

          $content  = 'Unable to generate embossing file. message['.$message.']';
          $content2 = 'Unable to generate embossing file. message['.$message.']';
          $haserror = TRUE;
        }

        if ($core->hasBatchCardUpload()) {
          $fileName = 'EMBOSS'. date('mdY');
        } else {
          $fileName = 'B'.$brcodeX .'_'. date('Ymd') .'_'. str_pad($batchNo, 4, '0', STR_PAD_LEFT) .'.txt';
        }
        break;

      case 'emv':
        $contentType = 'text/plain; charset="utf-8"';
        $xcntr = 0;
        
        $content = '';
        $content2= '';
        $message = '';
        $failedstatusupdate = 0;
        
        for ($i = 0; $i < $total; $i += $limit) {

          $paramsGetAllByOffset = $params;

          array_push($paramsGetAllByOffset, $limit); // 
          array_push($paramsGetAllByOffset, $offset); // offset

          if ($batchNox !== '') {
            $offset += $limit;
          }

          $query  = $query;
          $parameterbyoffset = json_encode($paramsGetAllByOffset);

          $result = $card->db->query($query, $paramsGetAllByOffset);
          $lastResult = $result->result_array();

          $result->free_result();
          $result->next_result();
          
          $this->queue = array();

          foreach ($lastResult as $row) {
            $xml->setXML($row['xml1']);
            $mpOut = '';
            $mpOut2= '';
            $xmlstring = '';
            
            $xBIN = $xml->getValue('BIN');
            $prseqno = intval($row['prseqno']);
            $acctType = $row['accttype'];
            $brcode = $row['brcode'];
            $prkey = $this->coreencrypt ? $row['prkey1'] : $row['prkey'];
            $cardNo = substr($prkey, (strlen($xBIN) + strlen($brcode)));

            $embossname = strtoupper($xml->getValue('MBOS'));

            if ($xml->getValue('MBOS') == "" || $xml->getValue('MBOS') == NULL) {
              $cardholdername = 'BANK';
            } else {
              $cardholdername = $embossname;
            }
            
            if (in_array('', array($prseqno, $acctType, $brcode, $prkey))) {
              continue;
            }

            $result = $this->card_model->getEMVFormat(
              $acctType,
              $brseqno,
              $ipAddress,
              $workstation,
              $userAudit,
              $override,
              $sessionID
            );

            $emvinfo = $result->row_array();

            if (!$this->cache->save($this->core->getSessionID() .'emvdatax', $emvinfo, CACHE_TTL)) {
              $_SESSION['emvdatax'];
            }
            
            $result->free_result();
            $result->next_result();
            
            $time = date('Y-M-d H:i:s');
            $name = $xml->getValue('MBOS');
            
            if (strlen(trim($name)) === 0) {
              $name = '#' . substr(' ', 17);
            }

            $embStatus = $embStatList['x'. $acctType];
        
            $mpprkey = $prkey;/*

            echo str_pad('<script>parent.updateProgress('. $mpprkey .');</script>'."\n", 1024);
            flush();*/


            // protocol 7
            // driver 65
            // XMLQ

            $fp = NULL;
            $rport = 3003;
            $rhost = 'localhost'; 

            try {
              if (@fsockopen($rhost, $rport, $errno, $errstr, 10)) {
                $fp = fsockopen($rhost, $rport, $errno, $errstr, 10);
              } else {
                $message = "Warning: Unable to connect to port [".$rport."]";
                $success = FALSE;
              }
            } catch (Exception $e) {
              
              $message = 'Catch Error while connecting to port['.$rport.']';//$errno !== NULL ? $errno : $e;
              $success = FALSE;
            }

            if (!$fp) {
              $success = FALSE;
              $message = "Warning: Unable to connect to port [".$rport."]";
            } else {
            
              $dtexpiry = date('Ymd', strtotime($row['dtexpire']));
              $out = '<MSGTYPE>50</><TRXCODE>'.TRXCODE_ICVV.'</><PRTYPE1>CARD</><PRKEY1>'.$mpprkey.'</><TPNODE>POS</><EXPIRY>'.$dtexpiry.'</><XML><SERVICECODE>'. $emvinfo['ICVV'] .'</></>'."\x00";
              

              fwrite($fp, $out);
            
              $msg = '';

              $starttime = time();

              while (TRUE) {
                $x = fgets($fp, 2);
                $time = time() - $starttime;
                if ($x == "\x00") {
                  $success = TRUE;
                  break;
                } elseif ($time > 60) {
                  $success = FALSE;
                  $message = "Connection Timeout (timelapse: ".$time." Starttime: ".$starttime." Endtime: ".time().")";
                  break;
                } else {
                  $success = TRUE;
                }

                $msg .= $x;
              }

              $xmlstring = $msg;
              $xmldata2->setXML($msg);
              
              fclose($fp);
            }

            $iCVV   = $xmldata2->getValue('HSMCVV');//'000';

            $queueSuccess = FALSE;
            $failedstatusupdate = 0;
            if ($success) {
              $msgtype = intval($xmldata2->getValue('MSGTYPE'));
              if ( in_array($msgtype, array(53, 73)) ) {
                $success = FALSE;
                $message = $xmldata2->getValue('SYSVDESC').$msgtype;
                
              } else {

                if (!$success) { 
                  $message = 'Unable to save data.';
                } else {
                  $message .= $xmlstring;
                }
              }
            }

            try {
              if (@fsockopen($rhost, $rport, $errno, $errstr, 10)) {
                $fp = fsockopen($rhost, $rport, $errno, $errstr, 10);
              } else {
                $message = "Warning: Unable to connect to port [".$rport."]";
                $success = FALSE;
              }
            } catch (Exception $e) {
              
              $message = 'Catch Error while connecting to port['.$rport.']';//$errno !== NULL ? $errno : $e;
              $success = FALSE;
            }

            if (!$fp) {
              $success = FALSE;
              $message = "Warning: Unable to connect to port [".$rport."]";
            } else {
            
              $dtexpiry = date('Ymd', strtotime($row['dtexpire']));
              $out = '<MSGTYPE>50</><TRXCODE>'.TRXCODE_CVV1.'</><PRTYPE1>CARD</><PRKEY1>'.$mpprkey.'</><TPNODE>POS</><EXPIRY>'.$dtexpiry.'</><XML><SERVICECODE>'. $emvinfo['CVV'] .'</></>'."\x00";
            
              fwrite($fp, $out);
            
              $msg = '';

              $starttime = time();

              while (TRUE) {
                $x = fgets($fp, 2);
                $time = time() - $starttime;
                if ($x == "\x00") {
                  $success = TRUE;
                  break;
                } elseif ($time > 60) {
                  $success = FALSE; 
                  $message = "Connection Timeout (timelapse: ".$time." Starttime: ".$starttime." Endtime: ".time().")";
                  break;
                } else {
                  $success = TRUE;
                }

                $msg .= $x;
              }

              $xmlstring = $msg;
              $xmldata1->setXML($msg);
              
              fclose($fp);
            }
            
            $CVV1   = $xmldata1->getValue('HSMCVV');//'000';          

            $queueSuccess = FALSE;
            $failedstatusupdate = 0;
            if ($success) {
              $msgtype = intval($xmldata1->getValue('MSGTYPE'));
              if ( in_array($msgtype, array(53, 73)) ) {
                $success = FALSE;
                $message = $xmldata1->getValue('SYSVDESC').$msgtype;
                
              } else {

                if (!$success) { 
                  $message = 'Unable to save data.';
                } else {
                  $message .= $xmlstring;

                  $queueSuccess = $this->_buildQuery($embStatus, $batchNo, $prseqno);

                  //$this->_buildQuery($acctType, $prseqno);
                  
                  $checker = $queueSuccess ? "GOOD" : "BAD";

                  /*echo str_pad('<script>console.log("'.$xmlstring.'");</script>'."\n", 1024);
                  flush();*/
                  if ($queueSuccess) {
                    $progress++;
                    if ($totalProg !== round($progress/$total * 100)) {
                      $totalProg = round($progress/$total * 100);
                              
                      echo str_pad('<script>parent.updateProgress('. $totalProg .');</script>'."\n", 1024);
                      flush();
                    }
                    
                    $xcntr++;

                  } else {
                    $failedstatusupdate++;
                  }
                }
              }
            }

            if ($queueSuccess) {
              
              $extcode  = $emvinfo['CVV'];
              $cvccode1 = $xmldata2->getValue('HSMCVV');//'001';

              // Emboss Serial No., length (6)
              $mpEmbSerial = str_pad($xcntr, 6, '0', STR_PAD_LEFT);
              // 1st Separator, length (1)
              $mpSeparator1 = '$'; 
              // Card Number Emb, length (19)
              $mpCardNoEmb = str_pad($mpprkey, 19, ' ', STR_PAD_RIGHT);
              // Card Number separator
              $mpCardNoSeparator = ' '; // single space
              // 1st Spaces, length (7)
              $mpSpaces1 = str_pad('', 7, ' ', STR_PAD_LEFT);
              // 2nd Separator, length (1)
              $mpSeparator2 = '*';
              // Member Date length (5)
              $mpMemberDate = date('m/y', strtotime($row['dtenroll']));
              // Enroll Date length (5)
              $mpEnrollDate = date('m/y', strtotime($row['dtenroll']));
              // Expiry Date length (5)
              $mpExpiryDate = date('m/y', strtotime($row['dtexpire']));
              // 2nd Spaces, length (5)
              $mpSpaces2 = str_pad('', 5, ' ', STR_PAD_LEFT);
              // 3rd Separator, length (2)
              $mpSeparator3 = '!(';
              // 3rd Spaces, length (20)
              $mpSpaces3 = str_pad('', 20, ' ', STR_PAD_LEFT);
              // 4th Separator, length (1)
              $mpSeparator4 = '#';
              // Name Embossed on card, length (26)
              $mpCardEmboss = str_pad($embossname, 26, ' ', STR_PAD_RIGHT);
              // Customer Name, length (35)
              $mpCustName = str_pad('', 16, ' ', STR_PAD_RIGHT);
              // Email Address, length (16)
              $mpEmailAddr = str_pad('', 16, ' ', STR_PAD_RIGHT);
              // Address1, length (50)
              $mpAddress1 = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // Address2, length (50)
              $mpAddress2 = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // Address3, length (50)
              $mpAddress3 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address4, length (50)
              $mpAddress4 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // Address5, length (50)
              $mpAddress5 = str_pad('', 40, ' ', STR_PAD_RIGHT);
              // City, length (50)
              $mpCity = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // Country, length (50)
              //$mpCountry = str_pad('', 50, ' ', STR_PAD_RIGHT);
              // zipcode, length (10)
              $mpZipcode = str_pad('', 10, ' ', STR_PAD_RIGHT);
              // Branch Code, length (10)
              $mpBranchCode = str_pad($row['brcode'], 10, ' ', STR_PAD_RIGHT);
              // 1st End Sentinel, length (1)
              $mpEndSentinel1 = ':';
              // 1st Start Sentinel, length (1)
              $mpStartSentinel1 = '%';

              
              // Track 1
                // Format Code
                $mpTrack1Formatcode = 'B';
                // Card Number
                $mpTrack1CardNumber = substr($mpprkey, 0, 19);
                // T1 1st Separator
                $mpTrack1Separator1 = '^';
                // Name in Track 
                $mpTrack1NameNTrack = str_pad($cardholdername.'/', 26, ' ', STR_PAD_RIGHT);
                // T1 2nd Separator
                $mpTrack1Separator2 = '^';
                // T1 Expiry Date
                $mpTrack1ExpiryDate = date('ym', strtotime($row['dtexpire']));
                // T1 Service Code
                $mpTrack1ServiceCde = $extcode;
                // T1 CVC 1
                $mpcvccode1 = str_pad($CVV1, 3, '0', STR_PAD_LEFT);
                // T1 trailing zeroes
                $mpZeroes1  = str_pad('', 6, '0', STR_PAD_LEFT);
                // T1 PIN Verification
                $mpTrack1PINVerify  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T1 1st Zeroes
                $mpTrack1Zeroes1  = str_pad('', 2, '0', STR_PAD_LEFT);
                // T1 CVV
                $mpTrack1CVV    = str_pad($CVV1, 3, '0', STR_PAD_LEFT);
                // T1 2nd Zeroes
                $mpTrack1Zeroes2  = str_pad('', 6, '0', STR_PAD_LEFT);
              
              // 2nd End Sentinel
              $mpEndSentinel2 = '?';
              // 2nd Start Sentinel
              $mpStartSentinel2 = ';';

              
              // Track 2
                $mpcvccode2 = str_pad($CVV1, 3, '0', STR_PAD_LEFT);
                // T1 trailing zeroes
                $mpZeroes2  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T2 Service Code
                $mpTrack2ServiceCde = $extcode;
                // T2 PIN Verification
                $mpTrack2PINVerify  = str_pad('', 5, '0', STR_PAD_LEFT);
                // T2 CVV
                $mpTrack2CVV    = str_pad($CVV1, 3, '0', STR_PAD_LEFT);

              // 3rd End Sentinel
              $mpEndSentinel3 = '?';
              // iCVV
              $mpICVV = str_pad($iCVV, 3, '0', STR_PAD_LEFT);
              // iCVV
              $mpCVV2 = str_pad('', 3, '0', STR_PAD_LEFT);
              // space separator
              $mpSpaceSeparator = ' ';
              // PAN Sequence Number
              $mpPANSeqNo = substr($mpprkey, 14, 2);
              // Branch Name/ID
              $mpBranch = str_pad('', 17, ' ', STR_PAD_LEFT);
              // @ separator
                // T2 Card Number
                $mpTrack2CardNumber = substr($mpprkey, 0, 19);
                // T2 1st Separator
                $mpTrack2Separator1 = '=';
                // T2 Expiry Date
                $mpTrack2ExpiryDate = date('ym', strtotime($row['dtexpire']));
                // T1 CVC 1st
              $mpAtSeparator = '@';

              $mpOut .= $mpEmbSerial.$mpCardNoEmb.$mpExpiryDate.$mpCardEmboss.$mpStartSentinel1.$mpTrack1Formatcode.$mpTrack1CardNumber.$mpTrack1Separator1.$mpTrack1NameNTrack.$mpTrack1Separator2.$mpTrack1ExpiryDate.$mpTrack1ServiceCde.
                $mpTrack1CVV.$mpEndSentinel2.$mpStartSentinel2.$mpTrack2CardNumber.$mpTrack2Separator1.$mpTrack2ExpiryDate.$mpTrack2ServiceCde.$mpTrack2CVV.$mpEndSentinel3.$mpICVV.$mpCVV2.$mpSpaceSeparator.$mpAddress1.$mpAddress2.$mpCity.
                $mpCountry.$mpZipcode.$mpAtSeparator."\r\n";

              $upd = $this->_updateAsEMV($ipAddress, $workstation, $userAudit, $override, $sessionID, $prseqno);

              $content .= $mpOut;//implode(',', $upd); 
/*              if ($upd['ERRNO'] == 0) {
                $content .= $mpOut;//implode(',', $upd); 
              } else {

                
                // continue
                // $content .= implode(',', $upd);//'failed to write card as EMV. Parameters['.$ipAddress.'|'.$workstation.'|'.$userAudit.'|'.$override.'|'.$sessionID.'|'.$prseqno.']'; 
              }*/

              $content2 .= $mpOut2;
            }
          }
          
          $queue = $this->_getQuery();
    
          $card->db->trans_begin();
          
          if (count($queue) > 0) {
            foreach ($queue as $x) {
              $sql = $x[0];
              $paramx = $x[1];
              $card->db->query($sql, $paramx);
            }
          }
          
          if ($card->db->trans_status() === FALSE) {
            $card->db->trans_rollback();
          } else {
            $card->db->trans_commit();
          }
        }

        $content = str_pad($xcntr, 4, '0', STR_PAD_LEFT)."\r\n".$content;

        $result->free_result();
        $result->next_result();

        $acctdesc = $card->card_model->getCardTypeDesc(intval($acctType)); 
        $acctrow = $acctdesc->row_array();
        $acctname = str_replace(" ", "", trim($acctrow['acctname']));

        $result->free_result();
        $result->next_result();

        if ($xcntr == 0 && $core->hasBatchCardUpload()) {
          if ($failedstatusupdate > 0) {
            $message = 'An error has occured while updating card status';
          }

          $content  = 'Unable to generate embossing file. message['.$message.']';
          $content2 = 'Unable to generate embossing file. message['.$message.']';
          $haserror = TRUE;
        }

        if ($core->hasBatchCardUpload()) {
          $fileName = 'EMBOSS'. date('mdY');
        } else {
          $fileName = 'B'.$brcodeX .'_'. date('Ymd') .'_'. str_pad($batchNo, 4, '0', STR_PAD_LEFT) .'.txt';
        }
        break;
 
      
      default:
        echo str_pad('<script>parent.noData('.json_encode($paramsGetAll).')</script>'."\n", 1024);
        flush();
            
        exit();
        break;
    }

    if ($totalProg == 99) {
      echo str_pad('<script>parent.updateProgress(100);</script>'."\n", 1024);
      flush();
    }
    echo '</body></html>';
    
    $result = $this->branch_model->getBranchList();
    $branches = $result->result_array();
      
    $result->free_result();
    $result->next_result();

    $branchcode = NULL;
    foreach ($branches as $row) {
      if ($brseqno == $row['brseqno']) {
        $branchcode = $row['brcode'];
      }
    }

    $cacheProcessed = array(
      'contentType' => $contentType,
      'content' => $content,
      'content2' => $core->hasBatchCardUpload() ? $content2 : NULL,
      'fileName' => $fileName
    );
    if (!$this->cache->save($this->core->getSessionID() .'processed', $cacheProcessed, CACHE_TTL)) {
      $_SESSION['embcontent'] = $cacheProcessed;
    }
    
    $auditXML = '';

    $embmode = $batchNox == '' ? 'Generate' : 'Regenerate';

    $auditXML .= '<old></><new></><field>'.$embmode.' Card Embossing</><details>Embossing No: '.$batchNo.', Count: '.$total.', Type: '.$embType.'</>';
    $this->card_model->insertAuditLogclixx(41,'990317',$brseqno,0,0,'CARD','',$userAudit,'','','','','','','',$userAudit,'','WEB','WEB',$workstation,$auditXML);
  }
  
  function _buildQuery($embStatus, $batchNo, $prseqno)
  {
    $this->load->library('core');
    if ($this->core->hasBatchCardUpload()) {  
      $v_asBGB = ", cifseqno = 1 ";
    } else {
      $v_asBGB = "";
    }
    $sql = "UPDATE prmaster SET ".
        "status = ? ". $v_asBGB .
        "WHERE prseqno = ? AND status = 9 LIMIT 1";
    
    $params = array($embStatus, $prseqno);
      
    $this->queue[] = array(
      $sql, $params
    );
    
    $sql = "UPDATE prdetail SET ".
        "embosno = ?, dtemboss = NOW() ".
        "WHERE prseqno = ? LIMIT 1";
    
    $params = array($batchNo, $prseqno);
    
    $this->queue[] = array(
      $sql, $params
    );
    
    return TRUE;
  }

  function _updateAsEMV($ipAddress, $workstation, $userAudit, $override, $sessionID, $prseqno)
  {
    $this->load->driver('cache', array('adapter' => 'apc', 'backup' => 'file'));
    $this->load->model('coreapp/card_model');

    if (!$emvrow = $this->cache->get($this->core->getSessionID() . 'emvdatax')) {
      $emvrow = $_SESSION['emvdatax'];
      //var_dump($this->core->getSessionID() . 'emvdatax');
    } 

    $trnExpr = isset($emvrow['isExpireDate']) ? $emvrow['isExpireDate'] : 0;
    $trnICVV = isset($emvrow['isCheckICVV']) ? $emvrow['isCheckICVV'] : 0;
    $servICVV = isset($emvrow['ICVV']) ? $emvrow['ICVV'] : 0;
    $trnCVV = isset($emvrow['isCheckCVV']) ? $emvrow['isCheckCVV'] : 0;
    $servCVV = isset($emvrow['CVV']) ? $emvrow['CVV'] : 0;
    $trnARQC = isset($emvrow['isVerifyARQC']) ? $emvrow['isVerifyARQC'] : 0;
    $trnARPC = isset($emvrow['isGenerateARPC']) ? $emvrow['isGenerateARPC'] : 0;
    $trnCntr = isset($emvrow['isSendTransactionCounter']) ? $emvrow['isSendTransactionCounter'] : 0;

    $trnTrack2 = isset($emvrow['isUseTrack2']) ? $emvrow['isUseTrack2'] : 0;
    $trnICCT2 = isset($emvrow['isUseICCTrack2']) ? $emvrow['isUseICCTrack2'] : 0;

    $result = $this->card_model->setCardAsEMV(
      $prseqno,
      $trnTrack2,
      $trnICCT2,
      $trnICVV,
      $servICVV,
      $trnCVV,
      $servCVV,
      $trnARQC,
      $trnARPC,
      $trnExpr,
      $trnCntr,
      $ipAddress,
      $workstation,
      $userAudit,
      $override,
      $sessionID
    );

    $row = $result->row_array();

    $debug = array($prseqno,
      $trnTrack2,
      $trnICCT2,
      $trnICVV,
      $servICVV,
      $trnCVV,
      $servCVV,
      $trnARQC,
      $trnARPC,
      $trnExpr,
      $trnCntr,
      $ipAddress,
      $workstation,
      $userAudit,
      $override,
      $sessionID);

    //array_push($row, strval(implode(',',$emvrow)));

    return $row;
  }
  
  function _getQuery()
  {
    return $this->queue;
  }
  
  function verify()
  {
    $this->load->model('coreapp/card_model');
    
    $batchNo = intval($this->input->post('batchNo', TRUE));
    
    if ($this->core->isHeadOffice()) {
      $brseqno = intval($this->input->post('brseqno', TRUE));
    } else {
      $brseqno = intval($this->core->getBranchID());
    }
    
    $userAudit = $this->core->getUserID();
    $sessionID = $this->core->getSessionID();
    
    /*$result = $this->card_model->getCardEmbossingByBatch(
      $batchNo, $brseqno, $userAudit, $sessionID
    );*/
    
    $query = "SELECT b.dtenroll
      FROM prmaster a, prdetail b
      WHERE b.prseqno = a.prseqno AND
      a.brseqno = ?
      AND b.embosno = ? LIMIT 1";
      
    $params = array($brseqno, $batchNo);
    
    $result = $this->card_model->db->query($query, $params);
    
    $row = $result->row_array();
    
    if ($result->num_rows() > 0) {
      $success = TRUE;
      $message = $this->core->formatDate('m/d/Y', $row['dtenroll']);
    } else {
      $success = FALSE;
      $message = 'Batch No. not found';
    }
    
    echo json_encode(array(
      'success' => $success,
      'message' => $message
    ));
  }
  
  function getProcessed()
  {
    $this->load->driver('cache', array('adapter' => 'file', 'backup' => 'apc'));
    $this->load->library('zip');
    
    if ($processed = $this->cache->get($this->core->getSessionID() . 'processed')) {
      
      if (!$this->core->hasBatchCardUpload()) {
        header('Content-type: '. $processed['contentType']);
        header('Content-Disposition: attachment; filename='. $processed['fileName']);
        header('Pragma: no-cache');
        header('Expires: 0');

        echo $processed['content'];
      } else {
        $data = array(  
                $processed['fileName'] . '_0101.txt' => $processed['content'],
                $processed['fileName'] . '_0201.txt' => $processed['content2']
            );
        


        $this->zip->add_data($data);
        $this->zip->download('EMBOSS'.date('mdY').'.zip');
      }
      
    } else if (isset($_SESSION['embcontent'])) {

      $processed = $_SESSION['embcontent'];

      unset($_SESSION['embcontent']);

      header('Content-type: '. $processed['contentType']);
      header('Content-Disposition: attachment; filename='. $processed['fileName']);
      header('Pragma: no-cache');
      header('Expires: 0');

      echo $processed['content'];
    } else {
      $this->load->helper('url');
      redirect('#welcome');
    }
  }
}
