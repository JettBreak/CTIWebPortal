	function _generateCards($orderNo, $brseqno)
	{
		$this->load->model('coreapp/card_model');
		$this->load->library('shortxml');
		
		$settings = array(); //for debugging
		$success = TRUE;
		$errors = array();
		
		$card = $this->card_model;
		$core = $this->core;
		$xml = $this->shortxml;
		
		$userAudit = $core->getUserID();
		$sessionID = $core->getSessionID();
		
		//validate session
		$result = $card->checkLogin($userAudit, $sessionID);
		$row = $result->row_array();
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		if (intval($row['errno']) === 8) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => $row['errmsg'],
				'errorno' => $row['errno']
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		$settings['orderNo'] = $orderNo;
		$settings['brseqno'] = $brseqno;
		
		//check if orderNo exists
		$result = $card->getCardOrder($orderNo, $brseqno);
		
		if ($result->num_rows() == 0) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Card Order No. '. $orderNo .' not found',
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		$row = $result->row_array();
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		$status = $settings['status'] = intval($row['status']);
		
		if ($status !== 1) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Invalid card order status: ' . $status,
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		$gencount 	= $settings['gencount'] = intval($row['gencount']);
		$qty 		= $settings['reqqty'] = intval($row['reqqty']); 
		$acctType 	= $settings['accttype'] = str_pad($row['accttype'],2,0,STR_PAD_LEFT);
		$bin 		= $settings['bin'] = $row['bin']; 
		$isper 		= $settings['ispersonalized'] = $row['ispersonalized'] === 'Y' ? TRUE : FALSE;
		$brcode 	= $settings['brcode'] = $row['brcode'];
		
		$xml1 = $row['xml1'];
		$xml->setXML($xml1);
		
		$prcdcode = '';
		//if inst has product code
		if ($core->hasProductCode()) {
			
			if ($xml1 !== '') {
				if ($xml->getValue('PRCDCODE') !== '') {
					$prcdcode = $settings['prcdcode'] = $xml->getValue('PRCDCODE');
				} else {
					$json = json_encode(array(
						'success' => FALSE,
						'message' => 'No product code assigned',
						'settings' => $settings,
						'errorno' => 69
					));
					
					echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
					flush();
					exit();
				}
			}
		} else {
			$prcdcode = $acctType;
		}

		//end
		
		//check card BIN
		if (strlen($bin) <= 0 || !$bin) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Invalid Card BIN',
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		//check required settings
		$required = array('gencount', 'reqqty', 'accttype', 'brcode');
		$missing = array();
		
		foreach ($required as $param) {
			if (!array_key_exists($param, $settings) || ($settings[$param] === NULL)) {
				$missing[] = $param;
			}
		}
		
		if (count($missing) > 0) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Invalid Card Settings<br />Must provide the following parameters: '. implode(', ', $missing),
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		//end
		
		//get card format
		$result = $card->getCardFormat(str_pad($acctType,2,0,STR_PAD_LEFT));
		
		$row = $result->row_array();
		
		$expyears 	= $settings['expyears'] = intval($row['expyears']);
		$format 	= $settings['format'] = $row['format'];
		$wts 		= $settings['wts'] = $row['wts'];
		$grace 		= $settings['grace'] = $row['grace'];
		$minday 	= $settings['minday'] = intval($row['minday']);
		$dtexp 		= $settings['dtexp'] = date('Y-m-d', strtotime('+'. $expyears .' year'));
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		//check required settings (card format)
		$required = array('expyears', 'format', 'wts', 'grace', 'minday', 'dtexp');
		
		if ($core->hasProductCode()) {
			array_push($required, 'prcdcode');
		}
		
		$missing = array();
		
		foreach ($required as $param) {
			if (!array_key_exists($param, $settings) || ($settings[$param] === NULL)) {
				$missing[] = $param;
			}
		}
		
		if (count($missing) > 0) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Invalid Card Settings<br />Must provide the following parameters: '. implode(', ', $missing),
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		if (intval($row['err']) === 1) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => 'Invalid card format',
				'settings' => $settings,
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		unset($missing);
		//end
		
		//get default limit
		$result = $card->getLimitSeqno($brseqno, $acctType, 'ONLN');//, $onlinelmt, $err);
		
		$row = array();
		if ($result->num_rows() > 0) {
			$row = $result->row_array();
			
			$onlinelmt = $row['onlinelmt'];		//12
		} else {
			$row['err'] = 1;
		}
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		//if no limits defined use global limits
		if (intval($row['err']) === 1) {
			$result = $card->getLimitSeqno(9999, $acctType, 'ONLN');//, $onlinelmt, $err);
			
			if ($result->num_rows() > 0) {
				$row = $result->row_array();
			
				$onlinelmt = $row['onlinelmt'];
				if (intval($row['err']) === 1) {
					$onlinelmt = 0;
				}
			} else {
				$onlinelmt = 0;
			}
			
			$result->free_result();
			$result->next_result();
			
			unset($result);
		}
		
		//get default limit
		$result = $card->getLimitSeqno($brseqno, $acctType, 'OFLN');//, $offlinelmt, $err);
		
		$row = array();
		if ($result->num_rows() > 0) {
			$row = $result->row_array();
		
			$offlinelmt = $row['offlinelmt'];		//0
		} else {
			$row['err'] = 1;
		}
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		//if no limits defined use global limits
		if (intval($row['err']) === 1) {
			$result = $card->getLimitSeqno('9999', $acctType, 'OFLN');//, $onlinelmt, $err);
			
			if ($result->num_rows() > 0) {
				$row = $result->row_array();
				
				$offlinelmt = $row['offlinelmt'];
				if (intval($row['err']) === 1) {
					$offlinelmt = 0;
				}
			} else {
				$offlinelmt = 0;
			}
			
			$result->free_result();
			$result->next_result();
			
			unset($result);
		}
		
		//get limit pin counter
		$result = $card->getLimitPINCountMax($acctType);
		$row = $result->row_array();
		
		$pinctr = 0;
		
		if (($result->num_rows() > 0) && (intval($row['err']) === 0)) {
			$pinctr = intval($row['pinctr']);	//3
		} else {
			$errors[] = 'No max PIN counter defined';
		}
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		//get allows default
		$result = $card->getAccountAllowsDefault($acctType);
		$row = $result->row_array();
		
		$initAllows = 0;
		
		if (($result->num_rows() > 0) && (intval($row['err']) === 0)) {
			$initAllows = $row['initAllows'];		//DFFFFFFBFFFF0000*/
		} else {
			$errors[] = 'No initial default allows defined';
		}
		
		$result->free_result();
		$result->next_result();
		
		unset($result);
		
		//check if personalized
		if ($isper) {
			$cifseqno = intval($xml->getValue('CUSTNO'));
			
			if ($cifseqno > 0) {
				//...
			} else {
				$errors[] = 'Card is personalized but no customer assigned';
			}
			
			$emboss	= $xml->getValue('EMBOSSNAME');
		} else {
			$cifseqno = 0;
			$emboss = '';
		}
		
		//errors found force exit
		if (count($errors) > 0) {
			$json = json_encode(array(
				'success' => FALSE,
				'message' => implode(', ', $errors),
				'errorno' => 69
			));
			
			echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
			flush();
			exit();
		}
		
		//set card order to "PROCESSING" status
		$query = "UPDATE crdorder SET ".
			"status = 7 ".
			"WHERE ".
			"orderno = ?".
			" AND status = 1 LIMIT 1";
		
		$params = array($orderNo);
		
		$card->db->query($query, $params);
		
		$first = 0;
		$totalProg = NULL;
		
		for ($ctr = 1;  $ctr <= $qty; $ctr++) {
			$card->db->trans_begin();
			
			$isProductExists = TRUE;
			
			$checkCtr = 0;
			while ($isProductExists) {
				$checkCtr++;
				
				if ($checkCtr >= 1000000) {
					$json = json_encode(array(
					'success' => FALSE,
						'message' => 'Unable to generate card number',
						'settings' => $settings,
						'errorno' => 69
					));
					
					echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
					flush();
					exit();
				}
				
				$query = "SELECT seqno,startcount,maxcount,stepcount FROM sequencx WHERE seqcode = 'CARD' LIMIT 1";
				
				$result = $card->db->query($query);
				
				if ($result->num_rows() > 0) {
					$row = $result->row_array();
					
					$seqno 		= $settings['seqno'] = intval($row['seqno']);
					$startcount = $settings['startcount'] = intval($row['startcount']);
					$maxcount 	= $settings['maxcount'] = intval($row['maxcount']);
					$stepcount 	= $settings['stepcount'] = intval($row['stepcount']);
					
					$series = $seqno + $stepcount;
					
					if ($series >= $maxcount) {
						$status = 2;
					} else {
						$status = 1;
					}
					
					$result->free_result();
					$result->next_result();
					
					unset($result);
					
					$query = "UPDATE sequencx SET status = ?, seqno = ? WHERE seqcode = 'CARD' AND seqno = ? LIMIT 1";
					
					$params = array($status, $series, $seqno);
					
					$card->db->query($query, $params);
				} else {
					$result->free_result();
					$result->next_result();
					
					unset($result);
				
					$json = json_encode(array(
						'success' => FALSE,
						'message' => 'Card sequence error',
						'settings' => $settings,
						'errorno' => 69
					));
					
					echo str_pad('<script>parent.showGenResult('. $json .');</script>'."\n", 1024);
					flush();
					exit();
				}
				
				$chkDigit = 0;
				
				/*$result = $card->generateCardSeries();
				
				$row = $result->row_array();
				
				$series = $row['series'];

				
				
				$result->free_result();
				$result->next_result();
				
				unset($result);*/
				
				if (strpos($format, 'C') !== FALSE) { //strpos() Returns the position as an integer. If needle is not found, strpos() will return boolean FALSE.
					$tmp = str_replace('C','', $format);
					
					$result = $card->getCardNo($tmp, $prcdcode, $bin, $series, $chkDigit, $brcode);
					$row = $result->row_array();
					
					$cardNo = str_replace('-', '', $row['cardno']);
					
					//$result->free_result();
					//$result->next_result();
					
					$result = $card->getCheckDigit($cardNo, $wts);
					$row = $result->row_array();
					
					$chkDigit = $row['chkdgt'];
					
					//$result->free_result();
					//$result->next_result();
				}
				
				echo json_encode(array($format, $prcdcode, $bin, $series, $chkDigit, $brcode));
				$result = $card->getCardNo($format, $prcdcode, $bin, $series, $chkDigit, $brcode);
					
				$row = $result->row_array();
				$cardNo = str_replace('-', '', $row['cardno']);// .'0';
				$isProductExists = $this->isProductExist('CARD', $cardNo);
				
				//$result->free_result();
				//$result->next_result();
			}
			
			$xml1 = '<BIN>'. $bin .'</>'.
				'<MBOS>'. $emboss .'</>'.
				'<ORDERNO>'. $orderNo .'</>';

			if($this->core->isCoreEncrypt()) {
				$xml1 .= '<CARDNO>'./*. trim(substr($cardNo, 9, 20)) .*/'</>';
			}
			
			if ($prcdcode) {
				$xml1 .= '<PRCDCODE>'. $prcdcode .'</>';
			}
			
			if ($first === 0) {
				$fcard = $cardNo;
				$first = 1;
			}

			if (str_pad($this->core->getBANKCODE(), 3, '0', STR_PAD_LEFT) == '002') {
				//save emb card status per accttype
				$result = $card->db->query("SELECT accttype, sf_getXMLValue(xml1,'GENNSTAT') as genstat FROM accttype WHERE prtype = 'CARD' AND accttype ='".$acctType."'");
				
				$genStatList = array();
			
				$statRow = $result->row_array();
				$genstat = !$statRow['genstat'] ? 17 : intval($statRow['genstat']);

				$result->free_result();
				$result->next_result();
			} else {
				$genstat = 9;
			}
			
			$query = "INSERT INTO prmaster SET ".
				"prtype  = 'CARD',".
				"prkey   = ?,".
				"cifseqno = ?,".
				"brseqno  = ?,".
				"agent    = 0,".
				"outlet   = ?,".
				"status   = ".$genstat.",".
				"accttype = ?,".
				//"dtlastact= NULL,".
				//"dtlastmov= NULL,".
				"payseqno = 0,".
				"isbalance='N',".
				"allows   = ?,".
				"useraudit= ?,".
				"wkstn = ?";
			
			$userAudit = $core->getUserID();
			$workstation = $core->getWorkstation();
			
			$params = array($cardNo, $cifseqno, $brseqno, NULL, $acctType, $initAllows, $userAudit, $workstation);
			
			$card->db->query($query, $params);
				
			$prseqno = $card->getLastInsertID();
			if ($prseqno > 0) {
				$query = "INSERT INTO prdetail SET ".
					"prseqno 	= ?,".
					"bankcode   = 0,".
					"pinoffset  = '000000',".
					"pinctr     = 0,".
					"pinctrmax  = ?,".
					"dtenroll   = NOW(),".
					"issuecnt   = 1,".
					"dtexpire   = ?,".
					"orderno    = ?,".
					"useraudit  = ?,".
					"wkstn      = ?,".
					"xml1       = ?";
				
				$params = array($prseqno, $pinctr, $dtexp, $orderNo, $userAudit, $workstation, $xml1);
				
				$card->db->query($query, $params);
				
				$query = "UPDATE crdorder SET ".
					"gencount = ?,".
					"dtgenerated = NOW() ".
					"WHERE orderno = ? LIMIT 1";
				
				$params = array($ctr, $orderNo);
				
				$card->db->query($query, $params);
				
				if ($onlinelmt > 0) {
					$query = "DELETE FROM limitxxx WHERE prseqno = ?";
					
					$params = array($prseqno);
					
					$card->db->query($query, $params);
					
					/*$query = "SELECT ".
