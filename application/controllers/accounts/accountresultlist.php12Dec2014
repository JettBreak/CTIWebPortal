<?php if ( ! defined('BASEPATH')) exit('No direct script access allowed');

class AccountResultList extends CI_Controller {
	
	private $fileVersion = '1.10.00';
	
	function __construct()
	{
		parent::__construct();
		$this->load->library('core');
		$this->core->checkUserAllows(ACCNTVERIFY_NO);

		$this->load->model('coreapp/user_model');

		$result = $this->user_model->checkLogin($this->core->getUserID(), $this->core->getSessionID());

		$row = $result->row_array();

		if (intval($row['errno']) > 0) {
			echo json_encode(array(
				'auth' => FALSE,
				'message' => 'Invalid Login Session. Please relogin'
			));
			exit();
		}
		
		$this->load->library('version');

		$file = basename(__DIR__) . '/' . basename(__FILE__);

		$verified = $this->version->validate($file, $this->fileVersion);

		if (!$verified) {
			echo json_encode(array(
				'auth' => FALSE,
				'message' => 'Module is out of date. Please contact software administrator.'
			));
		}
	}
	
	function index()
	{
		$this->load->driver('cache', array('adapter' => 'apc', 'backup' => 'file'));
		
		//get branches
		if (!$branches = $this->cache->get($this->core->getSessionID() . 'branches')) {
			$this->load->model('coreapp/branch_model');
			$result = $this->branch_model->getBranchList();
		
			$branches = $result->result_array();
			
			$result->free_result();
			$result->next_result();
			$this->cache->save($this->core->getSessionID() .'branches', $branches, CACHE_TTL);
		}
		
		$data['branches'] = NULL;
		
		if (count($branches) > 0) {
			foreach ($branches as $row) {
				//if user branch is not allowed to monitor users from other branches
				if (!$this->core->isHeadOffice() && $row['brseqno'] === $this->core->getBranchID()) {
					$data['branches'] = '<option value="'. $row['brseqno'] .'">'. $row['brname'] .'</option>';
					break;
				}
				$data['branches'] .= '<option value="'. $row['brseqno'] .'">'. $row['brname'] .'</option>';
			}
		} else {
			$data['branches'] = '<option value="">No Branches Defined</option>';
		}
		
		//if ($this->core->isHeadOffice()) {
			$data['uiToolbar'] = "$('.ui-toolbar:even').append($('#customToolbar .top').html());";
		//} else {
			$data['uiToolbar'] = NULL;
		//}
			$data['sessionExp'] = $this->core->getSessionExp();
		
		$this->load->view('accounts/accountresultlist', $data);
	}
	
	function getData()
	{
		$this->load->driver('cache', array('adapter' => 'apc', 'backup' => 'file'));
		$this->load->model('coreapp/card_model');
		$this->load->library('shortxml');
		
		$core		= $this->core;
		$xmldata	= $this->shortxml;
		
		if ($this->core->isHeadOffice()) {
			$brseqno = $this->input->get('brseqno', TRUE);
		} else {
			$brseqno = $this->core->getBranchID();
		}
		
		$ipAddress 		= $this->core->getIPAddress();
		$workstation 	= $this->core->getWorkstation();
		$userAudit 		= $this->core->getUserID();
		$override 		= '';
		$sessionID 		= $this->core->getSessionID();
		
		if ($acctreq = $this->cache->get($this->core->getSessionID() . 'acctreq')) {
			
			$id = $acctreq['cifseqno'];
			$xmldata->setXML($acctreq['xmlstring']);

			$data['custid'] = $id;
			$data['cifseqno'] = $acctreq['cifdata']['custid'];

			$data['custname'] = $acctreq['cifdata']['custname'];

			//tran allows		
			$result = $this->card_model->getDefaultTranAllows('ACCT');
			
			$data['tranAllows'] = NULL;
			
			$bin = '';
			foreach ($result->result_array() as $row) {
				$bin .= '1';
			}
			
			$result->free_result();
			$result->next_result();

			$details = array();
			foreach ($acctreq['accounts'] as $accountno) {
				$data['acctnoxml'] = substr($accountno, 0, 12);
				$data['accttypexml'] = substr($accountno, 12, 2);

				if ($data['accttypexml'] == '01') {
					$accttypedesc = 'SAVINGS ACCOUNT';
					$accttype = 10;
				} else {
					$accttypedesc = 'CURRENT ACCOUNT';
					$accttype = 20;

				}

				$details[] = array(
					'<input type="checkbox" name="accounts[]" id="'. $data['acctnoxml'] .'" value="'. $data['acctnoxml'] .':'. $accttype .':'. $data['cifseqno'] .'|'. $bin .'"/>',
					$data['acctnoxml'],
					//'<input type="checkbox" name="isPrimary[]" id="'. $data['acctnoxml'] .':primary' .'" value="Y:N"/>',
					$accttypedesc,
					$data['acctnoxml']
				);

			}
			$success = TRUE;
		} else {
			$success = FALSE;
		}

		echo json_encode(array(
			'success' => $success,
			'details' => $details
		));
	}
	
