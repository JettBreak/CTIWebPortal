	function verify()
	{
		$this->load->model('coreapp/card_model');
		$this->load->library('coreconverters');
		
		$card  = $this->card_model;
		$core  = $this->core;
		$input = $this->input;


		$accounts 	 	= $input->post('accounts');
		$isPrimary		= $input->post('brancList');
		$userOverride 	= $this->session->userdata('userOverride');
		$sessionID	 	= $core->getSessionID();

		
		$brseqno = $this->core->getBranchID();
		$success = '';
		$message = '';

		$created 		= 'Account/s successfully linked<br>';
		$createdcnt 	= 0;
		$notCreated 	= 'Failed to link account/s:<br>';
		$failedaccts 	= 0;


		foreach ($accounts as $accountinfo) {
			$prkey 		= substr($accountinfo, 0, 12);
			$accttype 	= substr($accountinfo, 13, 2);
			$cifseqno	= substr($accountinfo, 16, ( (strpos($accountinfo, '|') ) - 16 ) );
			$bin 		= substr($accountinfo, strpos($accountinfo, '|') + 1);
			
			$customersX[] = $cifseqno;

			$status      = $core->isISOCustomer() ? 4 : 10; //for verification

			$hex = $this->coreconverters->asciiBinToHex($bin);
			
			$ipAddress   = $core->getIPAddress();
			$workstation = $core->getWorkstation();
			$userAudit	 = $core->getUserID();

			$result = $card->insertAccount(
					$cifseqno,
					$brseqno,
					$prkey,
					$accttype,
					$status,//$status,
					$hex,
					$ipAddress,
					$workstation,
					$userAudit,
					$userOverride,
					$sessionID
				);

				$row = $result->row_array();

				$result->free_result();
				$result->next_result();

				if ($row['errno'] === '0') {
					$success = TRUE;
					$createdcnt++;
					$created .= '*'.$prkey.'<br>';
				} else {
					$failedaccts++;
					$errormessage = intval($row['errno']) != 1 ? $row['errmsg'] : $row['errmsg'] ;
					$notCreated .= '*'.$prkey.' - '.$errormessage.'<br>';
				}
			
		}
		

		$this->session->unset_userdata('userOverride');
		
		if ($createdcnt > 0) {
			$success = TRUE;
			$message .= $created;
			if ($failedaccts > 0) {
				$message .= '<br>';
			}
		}
		if ($failedaccts > 0) {
			$message .= $notCreated;
			if ($createdcnt === 0) {
				$success = FALSE;
			}
		}
		
		echo json_encode(array(
			'success' => $success,
			'message' => $message
		));
	}
	
}