// --------------------------------------------------------------------

/**
 * Abort AJAX Requests
 *
 * @return	void
 */
function abortAJAXRequests() {
	if (requests.length > 0) {
		for (var i = 0; i < requests.length; i++) {
			if (requests[i]) {
				requests[i].abort();
			}
		}
	}
}

