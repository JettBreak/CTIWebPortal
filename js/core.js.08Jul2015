// --------------------------------------------------------------------

/**
 * Show Floating Menu
 *
 * displays floating menu
 *
 * @return	void
 */
function initFloatMenu() {
    var menu = $('#floatMenu');
	
    menu.accordion({
        active: false,
        autoHeight: false,
        collapsible: true,
        header: 'span.menu'
    });
	
    var panel = $('.panel');
	
    panel.toggle(function () {
		
        menu.animate({
            left: -menu.width()
        }, {
            duration: 500,
            queue: false
        });
		
        panel.attr('title', 'Show Panel');
		
    }, function () {
		
        menu.animate({
            left: 0
        }, {
            duration: 500,
            queue: false
        });
		
        panel.attr('title', 'Hide Panel');
    });
    menu.show();
}

